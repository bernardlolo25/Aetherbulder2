GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The hosting URL
APP_URL="MY_APP_URL"

# DATABASE_URL: Managed directly in your Vercel Project Settings -> Environment Variables
# Format: mysql://<username>:<password>@<host>:4000/<database>?ssl={"rejectUnauthorized":true}
DATABASE_URL=""



